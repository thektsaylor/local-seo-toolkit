# Credentials
.env

# Check results stay local. Clients' data never goes in the repo.
data/*
!data/.gitkeep

# Real client configs stay local too. Only the example is committed.
clients/*.json
!clients/example.json

__pycache__/
*.pyc
.DS_Store

# Private planning notes stay on this Mac
notes/

# Packaged skill zips are built, not committed
dist/
